# ============================================================
# Azarine Landing Page — Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya.
# Di Vercel: set semua variabel ini di Project Settings > Environment Variables.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Admin ---
# Satu-satunya akun Google yang boleh login ke /admin
ADMIN_EMAIL=leonafariz01@gmail.com

# --- Firebase Admin SDK (Firestore + verifikasi login) ---
# Ambil dari Firebase Console > Project Settings > Service accounts >
# "Generate new private key" (file JSON), lalu salin field-nya ke sini.
FIREBASE_PROJECT_ID=azarine-b7762
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@azarine-b7762.iam.gserviceaccount.com
# Tempel private key dalam SATU baris, ganti newline dengan \n, apit dengan tanda kutip:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KEY_DI_SINI\n-----END PRIVATE KEY-----\n"

# --- Vertex AI (Gemini untuk Skin Analyzer) ---
# Service account GCP dengan role "Vertex AI User".
VERTEXAI_PROJECT_ID=your-gcp-project-id
VERTEXAI_LOCATION=us-central1
VERTEXAI_CLIENT_EMAIL=vertex-sa@your-gcp-project-id.iam.gserviceaccount.com
VERTEXAI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KEY_DI_SINI\n-----END PRIVATE KEY-----\n"
